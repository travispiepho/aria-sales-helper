# Copy to .env and adjust for local dev against a locally-running backend.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code.
# Defaults (in src/lib/api.ts) to the same deployed Railway backend the
# web PWA uses (see app/web/.env.production) if this is unset.
EXPO_PUBLIC_API_URL=https://aria-backend-production-0e99.up.railway.app
